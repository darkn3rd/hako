#!/usr/bin/env bash
# Check that this machine can build, test and publish this distro's boxes.
# Read-only: it reports problems and prints the commands that fix them for
# this platform. What the distro needs is in requirements.sh; the checks are
# in ../../scripts/doctor-lib.sh.
#
#   scripts/doctor                     (or: mise run doctor)
#   PROVIDERS=libvirt scripts/doctor   # skip the VirtualBox checks
#
# Exit status is 1 if any check fails; warnings do not fail it.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/requirements.sh"
. "$here/../../scripts/doctor-lib.sh"
cd "$here/.."
doctor_main
