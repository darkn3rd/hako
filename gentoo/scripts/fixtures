#!/usr/bin/env bash
# Example Vagrantfiles for the hako/gentoo box, one per provider and boot
# mode, and a runner that boots each one and checks it. These are integration
# tests of how a user runs the box (make test checks the box itself): a
# fixture passes only if the guest booted in the mode its name claims.
#
#   scripts/fixtures list              # which fixtures can run on this machine
#   scripts/fixtures gen  [NAME...]    # write fixtures/NAME/Vagrantfile, run nothing
#   scripts/fixtures test [NAME...]    # gen, vagrant up, check, reload, check, destroy
#
# NAME is PROVIDER-MODE (qemu-bios, qemu-uefi, libvirt-bios, libvirt-uefi).
# Without names, gen writes the fixtures this machine can run and test runs
# them, skipping the rest with the reason (list shows it). Naming a fixture
# makes gen write it regardless. Each fixture has its own directory, because
# Vagrant keeps its state beside the Vagrantfile. To bring one up by hand:
#
#   cd fixtures/qemu-uefi && vagrant up --provider qemu
#
# The fixtures use the local catalog of the box in boxes/ (make fixtures and
# make fixtures-test build it first), and are generated, so not committed.
# Run from the repo with make: make fixtures, make fixtures-test, make
# fixtures-list. See the README, "Testing example Vagrantfiles".
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
fixtures=$root/fixtures
. "$here/vagrant-lib.sh"

die() { echo "fixtures: $*" >&2; exit 2; }

# ARCH, VERSION, HOST_OS and the firmware paths are worked out once, by the
# Makefile (which also uses them to build and test the box).
env_out=$(make -s --no-print-directory -C "$root" fixtures-env) ||
  die "could not read the settings from the Makefile"
eval "$env_out"

box=$BOX
catalog=$root/$LOCAL_CATALOG

# UEFI firmware: the Makefile finds the code/vars pair on Linux; on a Mac
# Homebrew's QEMU keeps them in QEMU_SHARE.
case $ARCH in
  amd64) fw_code=edk2-x86_64-code.fd  fw_vars=edk2-i386-vars.fd
         names="qemu-bios qemu-uefi libvirt-bios libvirt-uefi" ;;
  arm64) fw_code=edk2-aarch64-code.fd fw_vars=edk2-arm-vars.fd
         names="qemu-uefi" ;;  # arm64 VMs are always UEFI
esac
efi_code=${EFI_CODE:-$QEMU_SHARE/$fw_code}
efi_vars=${EFI_VARS:-$QEMU_SHARE/$fw_vars}

case $(uname -m) in arm64|aarch64) host_arch=arm64 ;; *) host_arch=amd64 ;; esac
plugins=$(command -v vagrant >/dev/null && vagrant plugin list 2>/dev/null || true)
has_plugin() { printf '%s\n' "$plugins" | grep -q "^$1 "; }

# skip_reason NAME: print why this machine can't run the fixture and return
# 0, or return 1 when it can.
skip_reason() {
  local provider=${1%-*} mode=${1#*-}
  command -v vagrant >/dev/null || { echo "vagrant is not installed"; return 0; }
  [[ $host_arch == "$ARCH" ]] ||
    { echo "ARCH=$ARCH is not this machine's architecture (no emulation)"; return 0; }
  case $provider in
    qemu)
      has_plugin vagrant-qemu || { echo "vagrant plugin vagrant-qemu is not installed"; return 0; }
      command -v "$QEMU_BINARY" >/dev/null || { echo "$QEMU_BINARY is not installed"; return 0; }
      if [[ $HOST_OS != Darwin ]] && ! { [[ -r /dev/kvm && -w /dev/kvm ]]; }; then
        echo "no access to /dev/kvm"; return 0
      fi ;;
    libvirt)
      [[ $HOST_OS != Darwin ]] || { echo "vagrant-libvirt needs a Linux host"; return 0; }
      [[ $ARCH == amd64 ]] || { echo "arm64 libvirt fixtures are not written yet"; return 0; }
      has_plugin vagrant-libvirt || { echo "vagrant plugin vagrant-libvirt is not installed"; return 0; }
      libvirt_reachable || { echo "cannot connect to libvirt ($libvirt_uri)"; return 0; } ;;
  esac
  # vagrant-qemu attaches arm64 firmware itself; amd64 needs the files here.
  if [[ $mode == uefi && $ARCH == amd64 ]]; then
    [[ -f $efi_code ]] || { echo "no UEFI firmware at $efi_code (EFI_CODE=)"; return 0; }
    [[ $provider != qemu || -f $efi_vars ]] || { echo "no UEFI variables at $efi_vars (EFI_VARS=)"; return 0; }
  fi
  return 1
}

# write_fixture NAME: fixtures/NAME/Vagrantfile
write_fixture() {
  local name=$1 provider=${1%-*} mode=${1#*-} dir=$fixtures/$1
  mkdir -p "$dir"
  {
    cat <<HEAD
# Generated by scripts/fixtures; do not edit or commit.
# $name ($ARCH):
#   cd fixtures/$name && vagrant up --provider $provider
# After rebuilding the box (same version), drop the cached copy first:
#   vagrant box remove $box --box-version $VERSION --provider libvirt
require "fileutils"

Vagrant.configure("2") do |config|
  config.vm.box         = "$box"
  config.vm.box_url     = "file://$catalog"
  config.vm.box_version = "$VERSION"
  config.vm.synced_folder ".", "/vagrant", disabled: true

HEAD
    case $name in
      qemu-bios)
        cat <<'EOF'
  # vagrant-qemu boots x86_64 with BIOS (SeaBIOS) unless firmware is attached.
  config.vm.provider "qemu" do |qe|
    qe.ssh_auto_correct = true
  end
EOF
        ;;
      qemu-uefi)
        if [[ $ARCH == arm64 ]]; then
          cat <<'EOF'
  # vagrant-qemu attaches UEFI firmware to arm64 guests itself.
  config.vm.provider "qemu" do |qe|
    qe.ssh_auto_correct = true
  end
EOF
        else
          cat <<EOF
  # vagrant-qemu has no firmware setting for x86_64: attach the UEFI firmware
  # by hand, with this VM's own copy of the variables file.
  uefi_vars = File.join(__dir__, ".vagrant", "uefi-vars.fd")
  unless File.exist?(uefi_vars)
    FileUtils.mkdir_p(File.dirname(uefi_vars))
    FileUtils.cp("$efi_vars", uefi_vars)
  end

  config.vm.provider "qemu" do |qe|
    qe.ssh_auto_correct = true
    qe.extra_qemu_args = [
      "-drive", "if=pflash,format=raw,unit=0,readonly=on,file=$efi_code",
      "-drive", "if=pflash,format=raw,unit=1,file=#{uefi_vars}",
    ]
  end
EOF
        fi
        ;;
      libvirt-bios)
        cat <<'EOF'
  # vagrant-libvirt boots x86_64 with BIOS (SeaBIOS) by default.
  config.vm.provider :libvirt do |libvirt|
    libvirt.memory = 2048
    libvirt.cpus   = 2
  end
EOF
        ;;
      libvirt-uefi)
        cat <<EOF
  # loader is the read-only firmware code; nvram is this VM's own writable
  # copy of the UEFI variables (libvirt creates it from the matching template).
  config.vm.provider :libvirt do |libvirt|
    libvirt.memory       = 2048
    libvirt.cpus         = 2
    libvirt.machine_type = "q35"
    libvirt.loader       = "$efi_code"
    libvirt.nvram        = "/var/lib/libvirt/qemu/nvram/hako-gentoo-${name}_VARS.fd"
  end
EOF
        ;;
    esac
    echo "end"
  } > "$dir/Vagrantfile"
}

# Runs in the guest. $want is the boot mode the fixture's name claims.
guest_script='set -e
mode=bios; [ -d /sys/firmware/efi ] && mode=uefi
echo "boot mode: $mode (expected $want)"
[ "$mode" = "$want" ] || { echo "FAIL: booted in $mode mode, not $want" >&2; exit 1; }
sudo -n true && echo "passwordless sudo: ok"
state=$(systemctl is-system-running --wait || true)
echo "system state: $state"
if [ "$state" != running ]; then systemctl --failed --no-pager; exit 1; fi
systemd-analyze time | head -1'

# run_fixture NAME: boot, check, reload, check. The caller runs it in a
# subshell with the output in a log. That subshell is an `if` condition, where
# bash ignores set -e, so every step that can fail ends the run itself.
run_fixture() {
  local name=$1 provider=${1%-*} want=${1#*-}
  cd "$fixtures/$name" || exit 1
  trap 'vagrant destroy -f >/dev/null 2>&1 || true; rm -rf .vagrant' EXIT
  vagrant destroy -f >/dev/null 2>&1 || true
  rm -rf .vagrant
  vagrant up --provider "$provider" || exit 1
  vagrant ssh -c "want=$want; $guest_script" || exit 1
  # The second boot must work too: UEFI boots from empty variables each time.
  vagrant reload || exit 1
  vagrant ssh -c "want=$want; $guest_script" || exit 1
}

# select_names [NAME...]: the names to act on; sets $selected and $explicit.
select_names() {
  selected=$* explicit=
  if [[ $# -eq 0 ]]; then selected=$names; return; fi
  explicit=1
  local n
  for n in "$@"; do
    case " $names " in *" $n "*) ;; *) die "unknown fixture '$n' for $ARCH (have: $names)" ;; esac
  done
}

cmd_list() {
  echo "$box $VERSION ($ARCH) on $HOST_OS"
  local n reason
  for n in $names; do
    if reason=$(skip_reason "$n"); then printf '  %-13s skip: %s\n' "$n" "$reason"
    else printf '  %-13s ok\n' "$n"; fi
  done
  echo "  (no virtualbox fixtures: the Gentoo box is libvirt only)"
}

cmd_gen() {
  select_names "$@"
  local n reason wrote=0
  for n in $selected; do
    if [[ -z $explicit ]] && reason=$(skip_reason "$n"); then
      echo "skip $n: $reason (name it to generate anyway)"; continue
    fi
    write_fixture "$n"; wrote=1
    echo "fixtures/$n/Vagrantfile"
    echo "  cd fixtures/$n && vagrant up --provider ${n%-*}"
  done
  [[ $wrote == 1 ]] || { echo "fixtures: nothing generated" >&2; exit 1; }
}

cmd_test() {
  select_names "$@"
  [[ -f $catalog ]] || die "no $LOCAL_CATALOG: run make fixtures-test (it builds the catalog)"
  local n reason pass= fail= skip= ran=0 log need_libvirt=
  for n in $selected; do
    if reason=$(skip_reason "$n"); then
      echo "SKIP $n: $reason"; skip="$skip $n"; continue
    fi
    [[ ${n%-*} == libvirt ]] && need_libvirt=1
    runnable="${runnable:-} $n"
  done
  [[ -n ${runnable:-} ]] || { echo "fixtures: nothing here can run (see: scripts/fixtures list)" >&2; exit 1; }

  drop_cached_box "$box" "$VERSION" libvirt
  [[ -z $need_libvirt ]] || drop_stale_libvirt_volumes "$box" "$VERSION"

  for n in $runnable; do
    write_fixture "$n"
    log=$fixtures/$n/test.log
    printf 'RUN  %s ...\n' "$n"
    if ( run_fixture "$n" ) > "$log" 2>&1; then
      echo "PASS $n: $(grep -a -m1 '^boot mode:' "$log"), $(grep -a 'Startup finished' "$log" | tail -1 | sed 's/.*= //')"
      pass="$pass $n"
    else
      echo "FAIL $n (full log: fixtures/$n/test.log); last lines:"
      tail -n 15 "$log" | sed 's/^/     /'
      fail="$fail $n"
    fi
    ran=$((ran + 1))
  done
  echo "passed:${pass:- none}  failed:${fail:- none}  skipped:${skip:- none}"
  [[ -z $fail ]]
}

case ${1:-} in
  list) shift; cmd_list "$@" ;;
  gen)  shift; cmd_gen "$@" ;;
  test) shift; cmd_test "$@" ;;
  *) sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
