# Installed by hako. The box ships without SSH host keys so every VM gets
# its own; generate them on first boot before sshd can start.
#
# DefaultDependencies=no: with the defaults this unit would start after
# basic.target, which comes after sockets.target, which comes after
# ssh.socket -- an ordering cycle that systemd may break by dropping
# ssh.socket. (Ubuntu's own sshd-keygen.service only runs on a systemd
# "first boot", which would also re-apply unit presets, so it is not used.)
[Unit]
Description=Generate SSH host keys on first boot
DefaultDependencies=no
After=local-fs.target
Before=ssh.socket ssh.service sockets.target
ConditionPathExistsGlob=!/etc/ssh/ssh_host_*_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A

[Install]
WantedBy=sockets.target
