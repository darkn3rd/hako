#cloud-config
# NoCloud seed used ONLY while Packer builds the box. It creates the
# `vagrant` user with Vagrant's well-known insecure public keys so Packer
# (and later Vagrant) can SSH in. The seed is not part of the final box,
# and scripts/cleanup.sh resets cloud-init afterwards.
users:
  - name: vagrant
    gecos: Vagrant
    shell: /bin/bash
    groups: [adm, sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    # Vagrant convention: password "vagrant" (console only; SSH password
    # login stays disabled).
    plain_text_passwd: vagrant
    ssh_authorized_keys:
      - ssh-rsa  vagrant insecure public key
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key
ssh_pwauth: false
# Grow the root partition to the full disk size Packer gives the VM.
growpart:
  mode: auto
  devices: ["/"]
package_update: false
package_upgrade: false
